import flamer




@Flamer(port: 3000)
async fn main() {
    flamer.get(
        '/', 
        () {'Welcome to Flamer!'}
    )
    flamer.get(
        "/users", 
        () {
            json(["alice", 
            "bob", 
            "charlie"])
        }
    )
    await flamer.listen()
}

await main()
