@Docs("### 🔥 Flamer

***Fast, Express.js-inspired backend web framework for Flame.***

Leverages the high performance of Rust **Axum** and **Tokio** under the hood with a clean, expressive Flame API.

#### Features
- **High Performance**: Native async I/O powered by Tokio & Axum
- **Expressive Routing**: Intuitive HTTP shortcuts (`get`, `post`, `put`, `delete`, `patch`, `head`, `options`, `any`)
- **Path Filtering & Extraction**: Named parameter extraction (`extractPathParams`), wildcards, and prefix checks (`matchPath`, `pathFilter`)
- **Query String Parsing**: Instant query string decoding (`parseQuery`, `getQueryParam`)
- **Response Helpers**: Built-in helpers for `json()`, `html()`, `text()`, `redirect()`, `status()`, and error responses
- **Scope Injection**: `@Flamer(port: 3000)` injects the server instance directly into local scope

#### Quick Example
```flame
import flamer

@Flamer(port: 3000)
async fn main() {
    flamer.get('/', () {
        html('<h1>Hello from Flamer!</h1>')
    })

    flamer.get('/api/users', () {
        json(['Alice', 'Bob'])
    })

    await flamer.listen()
}

await main()
```
")
package flamer
import native.flamer_server
import std.json as json_mod

@Docs("Helper function to create a new Response object with body, status code, and content type.

**Example:**
```flame
let res = response('Hello World', 200, 'text/plain')
```")
export fn response(body: String, status: Int = 200, contentType: String = "text/plain") -> Response {
    let mut res = Response.new(body)
    res.setStatus(status)
    res.setContentType(contentType)
    return res
}

@Docs("Initializes and configures a Flamer Server with optional port and host.

When used as an annotation on an async function, it injects the `flamer` server instance directly into the local scope.

**Example:**
```flame
@Flamer(port: 3000)
async fn main() {
    flamer.get('/', () { 'Welcome to Flamer!' })
    flamer.get('/api/users', () { json(['Alice', 'Bob']) })
    await flamer.listen()
}
await main()
```")
export annotation Flamer(port: Int = 3000, host: String = "127.0.0.1") -> FlamerServer {
    let mut s = flamer_server.init()
    s.setPort(port)
    s.setHost(host)
    return s
}

@Docs("Creates a new FlamerServer instance manually with specified port and host.

**Example:**
```flame
let app = flamer.server(8080)
app.get('/ping', () { 'pong' })
await app.listen()
```")
export fn server(port: Int = 3000, host: String = "127.0.0.1") -> FlamerServer {
    let mut s = flamer_server.init()
    s.setPort(port)
    s.setHost(host)
    return s
}

@Docs("Initializes a default FlamerServer instance listening on 127.0.0.1:3000.")
export fn init() -> FlamerServer {
    let mut s = flamer_server.init()
    return s
}

@Docs("Declares a path filter pattern for route matching, prefix checking, or named parameter extraction.

When applied to a handler function, injects the `pathfilter` object directly into the handler's scope with:
- `pathfilter.pattern`: Configured pattern string (e.g. `/api/*` or `/users/:userId`)
- `pathfilter.matches(path)`: Returns true if the path matches pattern wildcards or parameters
- `pathfilter.filter(path)`: Returns true if the path starts with the pattern prefix
- `pathfilter.extract(path)`: Extracts named `:param` segments into a Formula object

**Example:**
```flame
@PathFilter('/users/:userId/orders/:orderId')
fn userProfile() -> String {
    let p = pathfilter.extract('/users/42/orders/101')
    return json({
        user_id: p.userId,
        order_id: p.orderId,
        is_matched: pathfilter.matches('/users/42/orders/101')
    })
}
```")
export annotation PathFilter(pattern: String = "*") -> Formula {
    flamer_server.registerPathFilter(pattern)
    return formula {
        pattern: pattern,
        prefix: pattern,
        matches: (path: String = "") -> Bool {
            return flamer_server.pathFilterMatches(path)
        },
        filter: (path: String = "") -> Bool {
            return flamer_server.pathFilterMatches(path)
        },
        extract: (path: String = "") -> Formula {
            let uid = flamer_server.pathFilterUserId(path)
            return formula {
                userId: uid,
                id: uid
            }
        },
        param: (k: String) -> String {
            return flamer_server.pathFilterParam(k)
        },
        kind: "path_filter"
    }
}

@Docs("Declares an expected query parameter key for route handler decoding, fallback handling, and full query parsing.

When applied to a handler function, injects the `query` object directly into the handler's scope with:
- `query.key`: Parameter key name (e.g. `\"q\"` or `\"name\"`)
- `query.defaultValue`: Configured default fallback value
- `query.get(source = \"\")`: Extracts parameter value from active request or provided query string
- `query.value()`: Returns decoded parameter value from active request
- `query.parse(source = \"\")`: Parses active or provided query string into a Formula object

**Example:**
```flame
@Query('name', 'guest')
fn greetUser() -> String {
    let name = query.get()
    return json({ name: name, default: query.defaultValue })
}
```")
export annotation Query(key: String = "", default_val: String = "") -> Formula {
    flamer_server.registerQuery(key, default_val)
    return formula {
        key: key,
        defaultValue: default_val,
        get: () -> String {
            return flamer_server.queryGet("")
        },
        value: () -> String {
            return flamer_server.queryGet("")
        },
        parse: (query_str: String) -> Formula {
            return parseQuery(query_str)
        },
        kind: "query"
    }
}

@Docs("Configures Cross-Origin Resource Sharing (CORS) policy for the decorated handler.

When applied to a handler function, injects the `cors` object directly into the handler's scope with:
- `cors.origin`: Permitted origin pattern (e.g. `\"*\"` or `\"https://example.com\"`)
- `cors.methods`: Allowed HTTP methods (e.g. `\"GET,POST,OPTIONS\"`)
- `cors.headers`: Allowed headers (e.g. `\"Content-Type,Authorization\"`)
- `cors.isAllowed(clientOrigin)`: Returns true if the client origin is permitted

**Example:**
```flame
@Cors(origin: '*', methods: 'GET,POST,OPTIONS')
fn healthCheck() -> String {
    let allowed = cors.isAllowed('https://client.example.com')
    return json({ status: 'ok', cors_origin: cors.origin, is_allowed: allowed })
}
```")
export annotation Cors(origin: String = "*", methods: String = "GET,POST,PUT,DELETE,PATCH,OPTIONS", headers: String = "*") -> Formula {
    flamer_server.registerCors(origin, methods, headers)
    return formula {
        origin: origin,
        methods: methods,
        headers: headers,
        isAllowed: (clientOrigin: String = "") -> Bool {
            return flamer_server.corsIsAllowed(clientOrigin)
        },
        kind: "cors"
    }
}

@Docs("Applies authentication requirement and Role-Based Access Control (RBAC) requirement.

When applied to a handler function, injects the `auth` object directly into the handler's scope with:
- `auth.role`: Required role (e.g. `\"admin\"` or `\"user\"`)
- `auth.check(userRole = \"\")`: Validates given user role against required role (or reads from query param `role`)
- `auth.authorize(userRole = \"\")`: Authorizes access if role matches

**Example:**
```flame
@Auth('admin')
fn adminDashboard() -> String {
    let isAdmin = auth.check()
    return json({ role: auth.role, authorized: isAdmin })
}
```")
export annotation Auth(role: String = "user") -> Formula {
    flamer_server.registerAuth(role)
    return formula {
        role: role,
        required: true,
        check: (userRole: String = "") -> Bool {
            return flamer_server.authCheck(userRole)
        },
        authorize: (userRole: String = "") -> Bool {
            return flamer_server.authCheck(userRole)
        },
        kind: "auth"
    }
}

@Docs("Attaches named middleware metadata to a handler or controller function for logging, auditing, and telemetry.

When applied to a handler function, injects the `middleware` object directly into the handler's scope with:
- `middleware.name`: Configured middleware name (e.g. `\"request_logger\"`)
- `middleware.kind`: Type identifier (`\"middleware\"`)

**Example:**
```flame
@Middleware('request_logger')
fn echoPayload(body: String) -> String {
    println('Middleware: ' + middleware.name)
    return body
}
```")
export annotation Middleware(name: String) -> Formula {
    flamer_server.registerMiddleware(name)
    return formula {
        name: name,
        kind: "middleware"
    }
}

@Docs("Checks whether a request path matches a pattern containing `:params` or `*` wildcards.

**Examples:**
```flame
matchPath('/users/:id', '/users/42')          // true
matchPath('/static/*', '/static/css/app.css') // true
```")
export fn matchPath(pattern: String, path: String) -> Bool {
    return flamer_server.matchPath(pattern, path)
}

@Docs("Extracts named `:param` segments from a path into a Formula object.

**Example:**
```flame
let p = extractPathParams('/users/:id/posts/:slug', '/users/42/posts/intro')
println(p.id)   // '42'
println(p.slug) // 'intro'
```")
export fn extractPathParams(pattern: String, path: String) -> Formula {
    let json_str = flamer_server.extractPathParamsJson(pattern, path)
    return json_mod.fromJson(json_str)
}

@Docs("Extracts a specific named path parameter from a pattern and path using native Rust.")
export fn getPathParam(pattern: String, path: String, key: String) -> String {
    return flamer_server.getPathParam(pattern, path, key)
}

@Docs("Checks if a URL path starts with a given prefix filter.

**Example:**
```flame
pathFilter('/api', '/api/v1/users') // true
```")
export fn pathFilter(prefix: String, path: String) -> Bool {
    return flamer_server.pathFilter(prefix, path)
}

@Docs("Parses a URL query string (e.g. `\"search=flame&limit=10\"`) into an Object/Formula.

**Example:**
```flame
let q = parseQuery('search=flame&page=1')
println(q.search) // 'flame'
println(q.page)   // '1'
```")
export fn parseQuery(query: String) -> Formula {
    let json_str = flamer_server.parseQueryJson(query)
    return json_mod.parse(json_str)
}

@Docs("Retrieves the value of a specific query parameter from a query string, with optional default fallback.

**Example:**
```flame
let sort = getQueryParam('search=flame&sort=desc', 'sort', 'asc')
println(sort) // 'desc'
```")
export fn getQueryParam(query: String, key: String, default_val: String = "") -> String {
    let val = flamer_server.getQueryParam(query, key)
    if val == "" {
        return default_val
    }
    return val
}

@Docs("Encodes a string into application/x-www-form-urlencoded percent format.")
export fn urlEncode(input: String) -> String {
    return flamer_server.urlEncode(input)
}

@Docs("Decodes a percent-encoded string back into standard text.")
export fn urlDecode(input: String) -> String {
    return flamer_server.urlDecode(input)
}

@Docs("Returns the query string of the current HTTP request being processed.")
export fn currentQuery() -> String {
    return flamer_server.currentQuery()
}

@Docs("Returns the URL path of the current HTTP request being processed.")
export fn currentPath() -> String {
    return flamer_server.currentPath()
}

@Docs("Returns the HTTP method of the current HTTP request being processed.")
export fn currentMethod() -> String {
    return flamer_server.currentMethod()
}

@Docs("Helper to construct a JSON response from any serializable value (Formula, Array, Object, String).

When returned from a route handler, Flamer automatically serializes the formula/object to standard JSON and sets the Content-Type to application/json.

**Example:**
```flame
flamer.get('/api/data', () {
    json({ success: true, count: 42 })
})
```")
export fn json(data: Unknown = "") -> Unknown {
    return data
}

@Docs("Serializes any formula, object, array, or value into a clean, valid JSON string.")
export fn toJson(data: Unknown = "") -> Unknown {
    return data
}

@Docs("Helper to construct a plain text response string.

**Example:**
```flame
flamer.get('/ping', () {
    text('pong')
})
```")
export fn text(content: String = "") -> String {
    return flamer_server.text(content)
}

@Docs("Helper to construct an HTML response string.

**Example:**
```flame
flamer.get('/', () {
    html('<h1>Welcome to Flamer</h1>')
})
```")
export fn html(content: String = "") -> String {
    return flamer_server.html(content)
}

@Docs("Helper to construct a redirect response formula with HTTP 302 or 301.")
export fn redirect(url: String, code: Int = 302) -> Formula {
    return formula {
        status: code,
        location: url,
        headers: formula {
            Location: url
        }
    }
}

@Docs("Helper to construct a structured status response formula.

**Example:**
```flame
status(204, 'No Content')
```")
export fn status(code: Int, body: String = "") -> Formula {
    return formula {
        status: code,
        body: body
    }
}

@Docs("Helper to construct a 200 OK response.")
export fn ok(body: String = "OK") -> String {
    return body
}

@Docs("Helper to construct a 201 Created response formula.")
export fn created(body: String = "Created") -> Formula {
    return formula {
        status: 201,
        body: body
    }
}

@Docs("Helper to construct a 400 Bad Request error response formula.")
export fn badRequest(message: String = "Bad Request") -> Formula {
    return formula {
        status: 400,
        error: message
    }
}

@Docs("Helper to construct a 401 Unauthorized error response formula.")
export fn unauthorized(message: String = "Unauthorized") -> Formula {
    return formula {
        status: 401,
        error: message
    }
}

@Docs("Helper to construct a 403 Forbidden error response formula.")
export fn forbidden(message: String = "Forbidden") -> Formula {
    return formula {
        status: 403,
        error: message
    }
}

@Docs("Helper to construct a 404 Not Found error response formula.")
export fn notFound(message: String = "Not Found") -> Formula {
    return formula {
        status: 404,
        error: message
    }
}

@Docs("Helper to construct a 500 Internal Server Error response formula.")
export fn internalError(message: String = "Internal Server Error") -> Formula {
    return formula {
        status: 500,
        error: message
    }
}
