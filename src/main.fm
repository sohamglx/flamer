@Docs("Initializes and configures a Flamer Server with optional port and host.

When used as an annotation on an async function, it injects the `flamer` server instance directly into the local scope and automatically applies all registered routes.

**Example:**
```flame
@Flamer(port: 3000)
async fn main() {
    flamer.get('/', () { 'Welcome to Flamer!' })
    await flamer.listen()
}
await main()
```")
export annotation Flamer(port: Int = 3000, host: String = "127.0.0.1") -> FlamerServer {
    let mut s = flamer_server.init()
    s.setPort(port)
    s.setHost(host)
    return s
}

@Docs("Creates a new FlamerServer instance manually with specified port and host.

**Example:**
```flame
let app = flamer.server(8080)
app.get('/ping', () { 'pong' })
await app.listen()
```")
export fn server(port: Int = 3000, host: String = "127.0.0.1") -> FlamerServer {
    let mut s = flamer_server.init()
    s.setPort(port)
    s.setHost(host)
    return s
}

@Docs("Initializes a default FlamerServer instance listening on 127.0.0.1:3000.")
export fn init() -> FlamerServer {
    let mut s = flamer_server.init()
    return s
}

